      "kernel": "uso.analysis-kernel/ak-0.1.0"
    },
    {
      "id": "coords.galactic",
      "description": "ICRS -> Galactic with the Astropy/Hipparcos rotation matrix.",
      "kernel": "uso.analysis-kernel/ak-0.1.0"
    },
    {
      "id": "coords.ecliptic",
      "description": "ICRS -> mean ecliptic of J2000.0 (obliquity 23.4392911°).",
      "kernel": "uso.analysis-kernel/ak-0.1.0"
    },
    {
      "id": "fink.object_position",
      "description": "DiaObject position = unit-vector mean of delivered DiaSource positions, rounded to 1e-5 deg.",
      "kernel": "uso.analysis-kernel/ak-0.1.0"
    },
    {
      "id": "fink.density",
      "description": "Complete DiaObject density computed at extraction with a NumPy port of the kernel's ang2pixNest; every sampled object's cell is re-checked against the kernel.",
      "kernel": "uso.analysis-kernel/ak-0.1.0"
    },
    {
      "id": "fink.time_scale",
      "description": "UTC dates from TAI with TAI − UTC = 37 s, verified with ERFA over every cohort date.",
      "kernel": "uso.analysis-kernel/ak-0.1.0"
    },
    {
      "id": "fink.sample",
      "description": "Simple random sample without replacement: the DiaObjects with the lowest md5(decimal diaObjectId).",
      "kernel": "uso.analysis-kernel/ak-0.1.0"
    },
    {
      "id": "antares.clipped_magnitudes",
      "description": "106 demo magnitudes at the exporter clip bounds were nulled.",
      "kernel": "uso.analysis-kernel/ak-0.1.0"
    }
