{
  "name": "skypulse-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.22.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm run validate:data",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-public-data.mjs",
    "validate:data:test": "node scripts/test-public-data-validator.mjs",
    "validate:data:production": "node scripts/validate-public-data.mjs --production"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
